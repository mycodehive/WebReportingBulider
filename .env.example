# Development only. Generate new keys before production; see docs/INSTALL.md.
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# DJANGO_SECRET_KEY=
# REPORT_SECRET_KEY=  # Fernet key; required when DJANGO_DEBUG=false
# DATABASE_URL=postgresql://user:password@localhost:5432/webreport
REPORT_MAX_ROWS=10000
REPORT_REST_ALLOWED_HOSTS=
# EMBED_ALLOWED_ORIGINS=https://your-service.example
# DJANGO_TRUST_PROXY_HEADERS=false  # true only for a trusted HTTPS reverse proxy

# Optional access country lookup (uv sync --extra geoip + local Country.mmdb)
REPORT_ANALYTICS_ENABLED=true
REPORT_GEOIP_DATABASE=
# Trust only actual reverse proxy IPs/CIDRs that sanitize X-Forwarded-For.
REPORT_TRUSTED_PROXIES=
