{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WRPX Manifest 1.0.0",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "format_version": {
      "const": "1.0.0"
    },
    "files": {
      "type": "object",
      "minProperties": 2,
      "maxProperties": 201,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "size": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10000000
          }
        },
        "required": [
          "sha256",
          "size"
        ]
      }
    }
  },
  "required": [
    "format_version",
    "files"
  ]
}
